# systemd user unit: berth gateway, one OpenAI-compatible port that starts engines on demand under a lease.
# Install: cp contrib/berth-gateway.service ~/.config/systemd/user/ && systemctl --user enable --now berth-gateway
# Undo:    systemctl --user disable --now berth-gateway && rm ~/.config/systemd/user/berth-gateway.service
# Keep the default KillMode (control-group): the gateway is a thin proxy, and nothing but it belongs to its
# cgroup. An engine it starts runs as its own `berth run` process in its own transient scope
# (berth-engine-*), so a restart of this unit does not stop a Strata that is loading or serving;
# the gateway adopts those engines again on its next start. Set WorkingDirectory if an engine's
# start command uses relative paths. Clients send the API key the gateway creates on first start
# (`berth key` prints it; ~/.config/berth/api.key, mode 600) as their bearer token.
[Unit]
Description=berth gateway - one port that starts engines on demand under a lease (loopback :9799)
After=berthd.service
Wants=berthd.service

[Service]
# The address is [gateway] listen in ~/.config/berth/berth.toml (default
# 127.0.0.1:9799), so a port change is a config edit and a restart here.
# Behind tailscale serve on this box: append  --gui-listen 127.0.0.1:9796 --allow-host <machine>.<tailnet>.ts.net
# for the wake pages, and  --harbor https://<machine>.<tailnet>.ts.net:9798  to send the gateway's /gui/ index to the
# harbor's SWITCH tab. --harbor must name the origin the browser reaches the harbor at, and a wake page opened by that
# name is only reachable through a serve in front of --gui-listen.
ExecStart=%h/.local/bin/berth gateway
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
